// =============================================================================
// ADOGTAME - Especificacion DBML del esquema relacional (v2)
// -----------------------------------------------------------------------------
// Deriva de: instruments/adog_MER.md (diagrama y diccionario de datos).
// Apoyo:     support/dev/solicitudes_verificacion.md y support/dev/manejo_roles.md.
//
// Sirve como REFERENCIA para pasar el modelo a una base de datos concreta. Es
// independiente del motor. Convenciones de esta especificacion:
//
//  - Los nombres del MER (USUARIO) pasan a minusculas en singular (usuario).
//  - DBML no expresa CHECK, indices parciales ni orden descendente: esos casos
//    se documentan en las notas con el prefijo [FISICO], para implementarlos
//    con la sintaxis del motor elegido.
//  - Las claves foraneas usan "delete: restrict": ningun usuario ni perro se
//    elimina fisicamente (RNF-10). Solo se borran fisicamente el test
//    (perfil_adoptante, RN-53), los favoritos desmarcados, los valores de
//    catalogo sin uso (RN-27) y las sesiones/enlaces caducados si se limpian.
//  - Los timestamps se guardan en UTC. Las fechas de creacion las asigna la
//    aplicacion.
//  - Los correos se normalizan a minusculas antes de guardarse, para que la
//    unicidad no distinga mayusculas (RN-01).
// =============================================================================

Project adogtame {
  note: '''
  # Adogtame - esquema relacional v2

  ## Reglas que el esquema NO garantiza (las controla la aplicacion)
  1. Cada usuario tiene exactamente un rol (usuario_rol admite varias filas; ver support/dev/manejo_roles.md).
  2. El perfil corresponde al rol: rol REFUGIO tiene fila en refugio; MIEMBRO, RESCATISTA y ADMINISTRADOR tienen fila en persona.
  3. Solo MIEMBRO, RESCATISTA y ADMINISTRADOR tienen perfil_adoptante (RN-42).
  4. Siempre existe al menos un ADMINISTRADOR activo (RN-11).
  5. No se solicita la adopcion de un perro propio ni adoptado (RN-28).
  6. Transiciones de estado: las solicitudes resueltas no cambian; un perro solo es disponible o adoptado (RN-24).
  7. Cascadas logicas: al eliminar un usuario o un perro se rechazan las solicitudes de adopcion pendientes (RN-10, RN-23).
  8. Maximo 5 fotos por perro, la de orden 1 es obligatoria (RF-19).
  9. El rol cambia solo de MIEMBRO a RESCATISTA, al aprobar una verificacion (RN-04).
  10. La eliminacion de un usuario oculta sus perros: es un filtro de lectura, no se modifica perro.eliminado (RN-10, RN-16).

  ## Datos iniciales (semillas)
  - rol: MIEMBRO, RESCATISTA, REFUGIO, ADMINISTRADOR.
  - raza y color: valores iniciales para que RF-19 funcione desde el despliegue (incluir un valor para mestizo).
  - usuario ADMINISTRADOR inicial (RN-12).

  ## Valores derivados que no se guardan
  Edad del perro (de fecha_nacimiento), lista de recomendaciones (RN-47), espera tras un rechazo (de fecha_resolucion) y ocultamiento de perros por usuario eliminado.
  '''
}

// =============================================================================
// ENUMERADOS
// Si el motor no tiene tipo ENUM, usar VARCHAR con CHECK o una tabla de
// catalogo. Los valores se escriben sin tildes ni espacios.
// =============================================================================

Enum token_tipo {
  confirmar_correo      [note: 'Confirma el correo de un registro. Vigencia 24 h (RNF-06)']
  recuperar_contrasena  [note: 'Recuperar contrasena. Vigencia 10 min']
  definir_contrasena    [note: 'Cuenta creada por aprobacion o por un administrador. Confirma tambien el correo (RN-13). Vigencia 10 min']
  actualizar_correo     [note: 'Confirma el nuevo correo (RN-05). Vigencia 10 min']
}

Enum solicitud_verificacion_tipo {
  rescatista  [note: 'Una persona ya registrada pide ser rescatista (RF-24)']
  refugio     [note: 'Una institucion sin cuenta pide registrarse (RF-06)']
}

Enum solicitud_verificacion_estado {
  pendiente  [note: 'Sin resolver. Las pendientes no caducan (RN-35)']
  aprobada   [note: 'Resuelta a favor']
  rechazada  [note: 'Resuelta en contra, sin motivo (RN-37)']
}

Enum vivienda_tipo {
  departamento
  casa_sin_patio
  casa_con_patio
}

Enum horas_solo_tipo {
  menos_4   [note: 'Menos de 4 horas']
  entre_4_8 [note: 'Entre 4 y 8 horas']
  mas_8     [note: 'Mas de 8 horas. Excluye cachorros (RN-43)']
}

Enum tamano_perro {
  pequeno
  mediano
  grande
}

Enum pelaje_perro {
  corto
  mediano
  largo
}

Enum sexo_perro {
  macho
  hembra
}

Enum estado_perro {
  disponible  [note: 'Visible en el listado y en las recomendaciones']
  adoptado    [note: 'Fuera del listado; se accede por enlace, favoritos o perfil del publicador (RN-17)']
}

Enum estado_solicitud_adopcion {
  pendiente   [note: 'Maximo una por perro y adoptante (RN-29)']
  aceptada    [note: 'Marca al perro como adoptado (RN-32)']
  rechazada   [note: 'Rechazada por el publicador o por una regla (RN-10, RN-23, RN-25, RN-32)']
  cancelada   [note: 'Cancelada por el adoptante (RN-31)']
}

// =============================================================================
// CUENTAS Y ACCESO
// =============================================================================

Table usuario {
  id_usuario        uuid          [pk]
  correo            varchar(120)  [not null, unique, note: 'Normalizar a minusculas. Unico entre cuentas activas y eliminadas (RN-01)']
  contrasena_hash   varchar(255)  [null, note: 'Hash con sal (RNF-03). NULL hasta que se defina']
  correo_confirmado boolean       [not null, default: false]
  eliminado         boolean       [not null, default: false, note: 'Borrado logico (RNF-10)']
  fecha_eliminacion timestamp     [null, note: 'NULL si esta activa; se limpia al restaurar']
  fecha_registro    timestamp     [not null]

  indexes {
    correo [unique, name: 'uq_usuario_correo']
  }

  Note: '''
  Cuenta de acceso. Un usuario es persona o refugio segun su perfil, y su tipo lo da el rol.
  [FISICO] CHECK: eliminado = true si y solo si fecha_eliminacion no es NULL.
  [FISICO] Un usuario con correo_confirmado = false no inicia sesion (RN-02).
  '''
}

Table rol {
  id_rol  smallint     [pk]
  codigo  varchar(20)  [not null, unique, note: 'MIEMBRO, RESCATISTA, REFUGIO o ADMINISTRADOR']
  nombre  varchar(50)  [not null]

  indexes {
    codigo [unique, name: 'uq_rol_codigo']
  }

  Note: 'Catalogo cerrado de tipos de cuenta. Se carga con semillas y no tiene mantenimiento desde la aplicacion.'
}

Table usuario_rol {
  id_usuario       uuid       [not null]
  id_rol           smallint   [not null]
  fecha_asignacion timestamp  [not null, note: 'En RESCATISTA y REFUGIO, la fecha de aprobacion']

  indexes {
    (id_usuario, id_rol) [pk, name: 'pk_usuario_rol']
    id_rol [name: 'ix_usuario_rol_rol', note: 'Listados por tipo (rescatistas, refugios), filtro de RF-27 y conteo de administradores (RN-11)']
  }

  Note: '''
  Rol vigente de cada usuario. El modelo es N:N, pero la aplicacion mantiene UN solo rol por usuario.
  Pasar de MIEMBRO a RESCATISTA REEMPLAZA la fila (no se agrega otra).
  [FISICO] Reforzar la regla de un solo rol con un indice unico sobre id_usuario es opcional: la convertiria de hecho en 1:N. Decision pendiente con quien definio el esquema.
  '''
}

Table persona {
  id_persona       uuid          [pk]
  id_usuario       uuid          [not null, unique]
  nombre           varchar(120)  [not null]
  telefono         varchar(10)   [not null, note: 'CHECK: 10 digitos que empiezan con 09']
  foto_perfil_url  varchar(255)  [null, note: 'Ubicacion de la foto en el almacenamiento. Preferible guardar una clave y no una URL (RNF-13)']
  descripcion      varchar(500)  [null]
  fecha_nacimiento date          [not null, note: 'CHECK: edad minima 18 anos']

  indexes {
    id_usuario [unique, name: 'uq_persona_usuario']
    nombre [name: 'ix_persona_nombre', note: 'Busqueda de usuarios por el administrador (RF-27). Sin distinguir mayusculas']
  }

  Note: 'Datos personales de MIEMBRO, RESCATISTA y ADMINISTRADOR. Relacion 1:1 con usuario; el usuario puede no tener persona (refugio).'
}

Table refugio {
  id_refugio         uuid          [pk]
  id_usuario         uuid          [not null, unique]
  nombre_institucion varchar(120)  [not null]
  ubicacion          varchar(255)  [not null]
  telefono           varchar(10)   [not null, note: 'CHECK: 10 digitos que empiezan con 09']
  foto_perfil_url    varchar(255)  [null, note: 'Igual criterio que persona.foto_perfil_url']
  descripcion        varchar(500)  [null]
  fecha_creacion     date          [null, note: 'CHECK: no futura']
  pagina_web         varchar(255)  [null, note: 'CHECK: solo protocolos http o https (RNF-22)']

  indexes {
    id_usuario [unique, name: 'uq_refugio_usuario']
    nombre_institucion [name: 'ix_refugio_nombre', note: 'Busqueda por el administrador. Sin distinguir mayusculas']
  }

  Note: 'Datos institucionales del rol REFUGIO. Relacion 1:1 con usuario; se crea al aprobar la solicitud (RF-25) o por un administrador (RF-26).'
}

Table token_correo {
  id_token           uuid          [pk]
  id_usuario         uuid          [not null]
  tipo               token_tipo    [not null]
  token_hash         varchar(255)  [not null, unique, note: 'Hash del enlace; el enlace en claro nunca se guarda']
  correo_nuevo       varchar(120)  [null, note: 'Solo en actualizar_correo. Sin unicidad: no se reserva (RN-07)']
  fecha_creacion     timestamp     [not null]
  fecha_expiracion   timestamp     [not null, note: '10 minutos, salvo confirmar_correo: 24 horas (RNF-06)']
  fecha_uso          timestamp     [null, note: 'NULL si no se uso']
  fecha_invalidacion timestamp     [null, note: 'NULL si no fue reemplazado']

  indexes {
    token_hash [unique, name: 'uq_token_correo_hash']
    (id_usuario, tipo) [name: 'ix_token_correo_usuario_tipo', note: 'Invalidar el enlace anterior y buscar el vigente']
    fecha_expiracion [name: 'ix_token_correo_expiracion', note: 'Limpieza de enlaces caducados']
  }

  Note: '''
  Enlaces de un solo uso enviados por correo. Vigente = sin fecha_uso, sin fecha_invalidacion y sin expirar.
  [FISICO] Un solo cambio de correo vigente por usuario (RN-06): indice UNIQUE PARCIAL sobre id_usuario donde tipo = 'actualizar_correo' y fecha_uso y fecha_invalidacion son NULL. Si el motor no admite indices parciales, invalidar el anterior dentro de la misma transaccion.
  [FISICO] CHECK: correo_nuevo no es NULL si y solo si tipo = 'actualizar_correo'.
  '''
}

Table sesion {
  id_sesion        uuid          [pk]
  id_usuario       uuid          [not null]
  token_hash       varchar(255)  [not null, unique, note: 'Hash del identificador de sesion']
  fecha_creacion   timestamp     [not null]
  ultima_actividad timestamp     [not null, note: 'Cierra a los 30 minutos sin actividad (RN-55, RNF-25)']
  fecha_cierre     timestamp     [null, note: 'NULL si esta activa']

  indexes {
    token_hash [unique, name: 'uq_sesion_hash']
    (id_usuario, fecha_cierre) [name: 'ix_sesion_usuario_activas', note: 'Cerrar las demas sesiones o todas (RN-54, RF-34)']
    ultima_actividad [name: 'ix_sesion_actividad', note: 'Cierre por inactividad y limpieza']
  }

  Note: 'Sesiones abiertas. Activa = fecha_cierre NULL y ultima_actividad dentro de los 30 minutos. Se consulta el rol del usuario en cada peticion para que un cambio de rol rija de inmediato.'
}

// =============================================================================
// VERIFICACION
// =============================================================================

Table solicitud_verificacion {
  id_solicitud       uuid                           [pk]
  tipo               solicitud_verificacion_tipo    [not null]
  estado             solicitud_verificacion_estado  [not null, default: 'pendiente']
  id_usuario         uuid                           [null, note: 'Rescatista: solicitante. Refugio: NULL hasta aprobar; luego la cuenta creada']
  correo_solicitante varchar(120)                   [null, unique, note: 'Solo refugio. Normalizar a minusculas. NULL al resolver']
  datos_registro     json                           [null, note: 'Solo refugio. Datos del formulario RF-06 sin correo. NULL al resolver. Instantanea, no fuente de verdad']
  id_admin_revisor   uuid                           [null]
  fecha_solicitud    timestamp                      [not null]
  fecha_resolucion   timestamp                      [null, note: 'NULL si esta pendiente. Se conserva siempre (calcula la espera de 5 min del rescatista)']

  indexes {
    correo_solicitante [unique, name: 'uq_solicitud_verif_correo', note: 'Como el correo es NULL al resolver, basta una unicidad simple (RN-01). En SQL Server, que admite un solo NULL, usar indice unico filtrado']
    id_usuario [name: 'ix_solicitud_verif_usuario_pendiente', note: '[FISICO] Debe ser UNIQUE PARCIAL donde tipo = rescatista y estado = pendiente (RN-36)']
    (id_usuario, estado, fecha_resolucion) [name: 'ix_solicitud_verif_ultimo_rechazo', note: 'Ultima solicitud rechazada de una persona (espera de 5 min)']
    (estado, fecha_solicitud) [name: 'ix_solicitud_verif_cola', note: 'Cola de pendientes del administrador, de la mas antigua a la mas reciente (RF-25)']
  }

  Note: '''
  Solicitudes de verificacion de rescatistas y de registro de refugios. Detalle en support/dev/solicitudes_verificacion.md.
  [FISICO] CHECK de consistencia entre columnas:
   1. tipo = rescatista: id_usuario NOT NULL; correo_solicitante y datos_registro NULL.
   2. tipo = refugio y estado = pendiente: correo_solicitante y datos_registro NOT NULL; id_usuario NULL.
   3. tipo = refugio y estado = aprobada: id_usuario NOT NULL; correo_solicitante y datos_registro NULL.
   4. tipo = refugio y estado = rechazada: id_usuario, correo_solicitante y datos_registro NULL.
   5. estado = pendiente: id_admin_revisor y fecha_resolucion NULL; si no, ambos NOT NULL.
  [FISICO] id_admin_revisor debe ser un usuario con rol ADMINISTRADOR (lo valida la aplicacion).
  '''
}

// =============================================================================
// RECOMENDACION
// =============================================================================

Table perfil_adoptante {
  id_persona          uuid             [pk]
  ritmo               smallint         [not null, note: 'CHECK: -1 tranquilo, 0 moderado, 1 activo']
  dedicacion          smallint         [not null, note: 'CHECK: -1 poco, 0 normal, 1 mucho']
  vivienda            vivienda_tipo    [not null]
  horas_solo          horas_solo_tipo  [not null]
  acepta_necesidades  boolean          [not null]
  experiencia         smallint         [not null, note: 'CHECK: -1 primera vez, 0 alguno, 1 mucha']
  comentario          varchar(150)     [null, note: 'Opcional. Se envia a la IA como dato, no como instruccion (RN-52)']
  fecha_actualizacion timestamp        [not null]

  Note: '''
  Test de estilo de vida (adog_REC.md, seccion 10). Un test por persona.
  Se borra de forma DEFINITIVA al eliminarlo o al eliminar la cuenta (RN-53). Es privado (RN-41).
  Las respuestas se guardan tal cual, sin calcular un perfil (RN-39).
  '''
}

// =============================================================================
// PERROS Y CATALOGOS
// =============================================================================

Table raza {
  id_raza smallint     [pk]
  nombre  varchar(60)  [not null, unique, note: 'Unico sin distinguir mayusculas (RN-27)']
  activo  boolean      [not null, default: true]

  indexes {
    nombre [unique, name: 'uq_raza_nombre']
  }

  Note: 'Catalogo administrado por RF-30. Un valor en uso solo se desactiva; no se elimina (RN-27). Renombrar cambia como se muestra en todos los perros (RN-26). Incluir una semilla para mestizo.'
}

Table color {
  id_color smallint     [pk]
  nombre   varchar(40)  [not null, unique, note: 'Unico sin distinguir mayusculas (RN-27)']
  activo   boolean      [not null, default: true]

  indexes {
    nombre [unique, name: 'uq_color_nombre']
  }

  Note: 'Catalogo administrado por RF-30. Mismas reglas que raza. Cada perro tiene un solo color; si se quisiera mas de uno habria que agregar una tabla intermedia.'
}

Table perro {
  id_perro               uuid          [pk]
  id_publicador          uuid          [not null]
  id_raza                smallint      [not null]
  id_color               smallint      [not null]
  nombre                 varchar(100)  [not null]
  fecha_nacimiento       date          [not null, note: 'Real o estimada (RN-21). CHECK: no futura ni de hace mas de 20 anos']
  tamano                 tamano_perro  [not null]
  peso_kg                decimal(5,2)  [not null, note: 'CHECK: de 0,5 a 90']
  pelaje                 pelaje_perro  [not null]
  sexo                   sexo_perro    [not null]
  ubicacion              varchar(255)  [not null]
  vacunas_al_dia         boolean       [not null]
  esterilizado           boolean       [not null]
  estado                 estado_perro  [not null, default: 'disponible']
  descripcion            text          [null, note: 'CHECK: maximo 1000 caracteres']
  caracteristicas        text          [null, note: 'CHECK: maximo 1000 caracteres']
  necesidades_especiales text          [null, note: 'CHECK: maximo 1000 caracteres. NULL si no tiene; no usar cadena vacia (el modulo de recomendacion distingue ambos casos)']
  fecha_publicacion      timestamp     [not null, note: 'Se conserva al volver a disponible (RN-24)']
  eliminado              boolean       [not null, default: false, note: 'Borrado logico e irreversible (RN-23)']
  fecha_eliminacion      timestamp     [null]

  indexes {
    (eliminado, estado, fecha_publicacion) [name: 'ix_perro_listado', note: 'Listado publico y recomendaciones. Orden por fecha_publicacion descendente (RN-18)']
    (id_publicador, eliminado, fecha_publicacion) [name: 'ix_perro_publicador', note: 'Mis perros y perfil del publicador']
    id_raza [name: 'ix_perro_raza', note: 'Filtro por raza y verificacion de "en uso" (RN-27)']
    id_color [name: 'ix_perro_color', note: 'Filtro por color y verificacion de "en uso" (RN-27)']
    nombre [name: 'ix_perro_nombre', note: 'Filtro por nombre; busqueda sin distinguir mayusculas']
  }

  Note: '''
  Perro en adopcion. Los filtros de RF-01 (raza, edad, tamano, genero, pelaje, color, esterilizado, fecha de publicacion y nombre) se resuelven sobre estas columnas; la edad se calcula desde fecha_nacimiento.
  Los demas filtros (tamano, sexo, pelaje, esterilizado) no llevan indice propio por su baja selectividad; revisar si el volumen de datos lo exige.
  [FISICO] CHECK: eliminado = true si y solo si fecha_eliminacion no es NULL.
  [FISICO] Visibilidad: un perro es visible si no esta eliminado y su publicador no esta eliminado (RN-16). Es un filtro de lectura.
  '''
}

Table foto_perro {
  id_foto              uuid          [pk]
  id_perro             uuid          [not null]
  clave_almacenamiento varchar(255)  [not null, note: 'Nombre generado por el sistema, sin metadatos (RNF-22)']
  orden                smallint      [not null, note: 'CHECK: 1 a 5. El 1 es la principal']

  indexes {
    (id_perro, orden) [unique, name: 'uq_foto_perro_orden']
  }

  Note: '''
  Fotos de un perro: una principal obligatoria y hasta 4 adicionales (RF-19). Las fotos no se borran del almacenamiento al eliminar el perro (RN-23).
  [FISICO] Garantizar que cada perro tenga la foto de orden 1 es regla de la aplicacion.
  '''
}

Table favorito {
  id_usuario uuid       [not null]
  id_perro   uuid       [not null]
  fecha      timestamp  [not null]

  indexes {
    (id_usuario, id_perro) [pk, name: 'pk_favorito']
    (id_usuario, fecha) [name: 'ix_favorito_usuario_fecha', note: 'Lista de favoritos, del ultimo agregado al primero (RN-18)']
  }

  Note: 'Perros marcados por cualquier usuario registrado, incluidos refugios y administradores (RN-19). Desmarcar elimina la fila. En la lectura se excluyen perros eliminados y se incluyen los adoptados (RN-16, RN-17).'
}

// =============================================================================
// ADOPCION
// =============================================================================

Table solicitud_adopcion {
  id_solicitud     uuid                       [pk]
  id_perro         uuid                       [not null]
  id_solicitante   uuid                       [not null, note: 'Referencia a persona.id_persona']
  estado           estado_solicitud_adopcion  [not null, default: 'pendiente']
  mensaje          text                       [not null, note: 'Generado al solicitar: nombre, perro, telefono vigente en ese momento y enlace al perfil (RN-30). No se actualiza']
  fecha_solicitud  timestamp                  [not null]
  fecha_resolucion timestamp                  [null, note: 'NULL si esta pendiente']

  indexes {
    (id_perro, id_solicitante) [name: 'ix_solicitud_adopcion_pendiente', note: '[FISICO] Debe ser UNIQUE PARCIAL donde estado = pendiente (RN-29). Tras un rechazo o cancelacion se puede volver a solicitar']
    (id_solicitante, fecha_solicitud) [name: 'ix_solicitud_adopcion_historial', note: 'Historial del adoptante, mas reciente primero (RF-17)']
    (id_perro, estado) [name: 'ix_solicitud_adopcion_perro_estado', note: 'Solicitudes recibidas por perro y rechazo masivo de las pendientes']
  }

  Note: '''
  Solicitud de adopcion de un perro por una persona. Las solicitudes no generan notificaciones (RN-33).
  El publicador se obtiene a traves del perro; no se repite aqui.
  Un refugio no solicita adopciones (RN-28): no tiene persona, por lo que no puede ser id_solicitante.
  [FISICO] CHECK: estado = pendiente si y solo si fecha_resolucion es NULL.
  [FISICO] La aplicacion rechaza solicitar un perro propio, adoptado o eliminado.
  '''
}

// =============================================================================
// RELACIONES
// Cardinalidad: ">" muchos a uno, "-" uno a uno. Todas restrict (RNF-10).
// DBML no expresa la opcionalidad del lado "uno" (ej. un usuario puede no tener
// persona): se indica en las notas de cada tabla.
// =============================================================================

Ref fk_usuario_rol_usuario:  usuario_rol.id_usuario > usuario.id_usuario [delete: restrict]
Ref fk_usuario_rol_rol:      usuario_rol.id_rol > rol.id_rol [delete: restrict]

Ref fk_persona_usuario:      persona.id_usuario - usuario.id_usuario [delete: restrict]
Ref fk_refugio_usuario:      refugio.id_usuario - usuario.id_usuario [delete: restrict]

Ref fk_token_correo_usuario: token_correo.id_usuario > usuario.id_usuario [delete: restrict]
Ref fk_sesion_usuario:       sesion.id_usuario > usuario.id_usuario [delete: restrict]

Ref fk_solicitud_verif_usuario: solicitud_verificacion.id_usuario > usuario.id_usuario [delete: restrict]
Ref fk_solicitud_verif_admin:   solicitud_verificacion.id_admin_revisor > usuario.id_usuario [delete: restrict]

Ref fk_perfil_adoptante_persona: perfil_adoptante.id_persona - persona.id_persona [delete: restrict]

Ref fk_perro_publicador:     perro.id_publicador > usuario.id_usuario [delete: restrict]
Ref fk_perro_raza:           perro.id_raza > raza.id_raza [delete: restrict]
Ref fk_perro_color:          perro.id_color > color.id_color [delete: restrict]
Ref fk_foto_perro_perro:     foto_perro.id_perro > perro.id_perro [delete: restrict]

Ref fk_favorito_usuario:     favorito.id_usuario > usuario.id_usuario [delete: restrict]
Ref fk_favorito_perro:       favorito.id_perro > perro.id_perro [delete: restrict]

Ref fk_solicitud_adopcion_perro:       solicitud_adopcion.id_perro > perro.id_perro [delete: restrict]
Ref fk_solicitud_adopcion_solicitante: solicitud_adopcion.id_solicitante > persona.id_persona [delete: restrict]

// =============================================================================
// GRUPOS DE TABLAS
// =============================================================================

TableGroup cuentas_y_acceso {
  usuario
  rol
  usuario_rol
  persona
  refugio
  token_correo
  sesion
}

TableGroup verificacion {
  solicitud_verificacion
}

TableGroup recomendacion {
  perfil_adoptante
}

TableGroup perros_y_catalogos {
  perro
  foto_perro
  raza
  color
  favorito
}

TableGroup adopcion {
  solicitud_adopcion
}
