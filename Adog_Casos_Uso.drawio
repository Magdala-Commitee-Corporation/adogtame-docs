        <!-- Nota -->
        <mxCell id="nota" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Actores en cursiva: abstractos (solo agrupan acciones).&lt;br&gt;• Persona = Adoptante + Publicador.&lt;br&gt;• Administrador hereda de Adoptante y Publicador, no de Persona: no solicita ser rescatista.&lt;br&gt;• Refugio solo es Publicador: no hace el test ni adopta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
