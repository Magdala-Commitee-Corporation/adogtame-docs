favoritos" link="data:page/id,p14" tooltip="Abrir detalle" id="p1c6"><mxCell style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="240" height="80" as="geometry"/></mxCell></UserObject><UserObject label="5. Perfil y panel de usuario" link="data:page/id,p15" tooltip="Abrir detalle" id="p1c7"><mxCell style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="370" width="240" height="80" as="geometry"/></mxCell></UserObject><UserObject label="6. Administración" link="data:page/id,p16" tooltip="Abrir detalle" id="p1c8"><mxCell style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="370" width="240" height="80" as="geometry"/></mxCell></UserObject><mxCell id="p1c9" value="Visitante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="40" height="80" as="geometry"/></mxCell><mxCell id="p1c10" value="Persona" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="40" height="80" as="geometry"/></mxCell><mxCell id="p1c11" value="Rescatista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="40" height="80" as="geometry"/></mxCell><mxCell id="p1c12" value="Refugio" style="shape=uml