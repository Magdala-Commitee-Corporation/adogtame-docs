ll id="p1c22" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p1c12" target="p1c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c23" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p1c12" target="p1c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c24" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p1c13" target="p1c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c25" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p1c13" target="p1c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c26" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p1c13" target="p1c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c27" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p1c13" target="p1c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c28" value="" style="endArrow=block;endFill=0;html=1;rounded=0;endSize=12;" edge="1" parent="1" source="p1c11" target="p1c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c29" value="Cada paquete se detalla en su pestaña de nivel 2 (doble clic o Ctrl+clic sobre el paquete para abrirla). El paquete 6 se descompone además en pestañas de nivel 3 (6.1, 6.2 y 6.3).&lt;br&gt;El administrador inicia sesión por el paquete 1 como cualquier usuario sin sesión (Visitante)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="510" width="580" height="82" as="geometry"/></mxCell><mxCell id="p1c30" value="Rescatista especializa a Persona y hereda todas sus asociaciones. Refugio no adopta ni guarda favoritos: en el paquete 4 solo confirma adopciones de sus perros y recibe sus notificaciones." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="602" width="580" height="54" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="1. Cuentas y acceso"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11t" value="Nivel 2 — 1. Cuentas y acceso" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11s" value="ADOGTAME — 1. Cuentas y acceso" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="300" height="254" as="geometry"/></mxCell><mxCell id="p11c3" value="1.1 Registrarse&lt;br&gt;(persona o refugio)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="80" width="200" height="64" as="geometry"/></mxCell><mxCell id="p11c4" value="1.2 Iniciar sesión" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="190" width="200" height="64" as="geometry"/></mxCell><mxCell id="p11c5" value="Visitante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="40" height="80" as="geometry"/></mxCell><mxCell id="p11c6" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p11c5" target="p11c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c7" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p11c5" target="p11c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p11c8" value="1.1: crea la cuenta con perfil persona o refugio; si es refugio, crea su solicitud de verificación pendiente. Envía el correo de confirmación. Las cuentas de administrador no se registran aquí (6.2.4).&lt;br&gt;1.2: Visitante representa a cualquier usuario sin sesión, incluido el administrador. Las cuentas suspendidas o desactivadas no inician sesión." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="314" width="560" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="2. Exploración"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p12t" value="Nivel 2 — 2. Exploración de perros y perfiles" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12s" value="ADOGTAME — 2. Exploración" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="540" height="354" as="geometry"/></mxCell><mxCell id="p12c3" value="2.1 Ver perros en adopción" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="80" width="200" height="64" as="geometry"/></mxCell><mxCell id="p12c4" value="2.2 Buscar y filtrar perros" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="210" width="200" height="64" as="geometry"/></mxCell><mxCell id="p12c5" value="2.3 Ver información de perro" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="145" width="200" height="64" as="geometry"/></mxCell><mxCell id="p12c6" value="2.4 Ver perfiles públicos y directorios" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="200" height="64" as="geometry"/></mxCell><mxCell id="p12c7" value="Visitante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="40" height="80" as="geometry"/></mxCell><mxCell id="p12c8" value="Persona" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="40" height="80" as="geometry"/></mxCell><mxCell id="p12c9" value="Rescatista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="40" height="80" as="geometry"/></mxCell><mxCell id="p12c10" value="Refugio" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="40" height="80" as="geometry"/></mxCell><mxCell id="p12c11" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="260" width="40" height="80" as="geometry"/></mxCell><mxCell id="p12c12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c7" target="p12c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c7" target="p12c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c7" target="p12c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c8" target="p12c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c8" target="p12c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c8" target="p12c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c10" target="p12c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c10" target="p12c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c20" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c10" target="p12c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c11" target="p12c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c22" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c11" target="p12c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c23" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p12c11" target="p12c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c24" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p12c5" target="p12c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c25" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p12c5" target="p12c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c26" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p12c6" target="p12c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c27" value="" style="endArrow=block;endFill=0;html=1;rounded=0;endSize=12;" edge="1" parent="1" source="p12c9" target="p12c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p12c28" value="Solo se muestran perros visibles (no eliminados y con publicador activo); un perro no visible responde 404. El visitante no ve teléfono ni correo de los usuarios.&lt;br&gt;Rescatista especializa a Persona y hereda todas sus asociaciones (salvo 5.3). Elipses grises con borde discontinuo: casos de uso de otra pestaña, incluidos como referencia." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="414" width="560" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="3. Gestión de perros"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p13t" value="Nivel 2 — 3. Gestión de perros" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p13s" value="ADOGTAME — 3. Gestión de perros" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="300" height="364" as="geometry"/></mxCell><mxCell id="p13c3" value="3.1 Poner perro en adopción" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="80" width="200" height="64" as="geometry"/></mxCell><mxCell id="p13c4" value="3.2 Editar información de perro" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="190" width="200" height="64" as="geometry"/></mxCell><mxCell id="p13c5" value="3.3 Eliminar perro&lt;br&gt;(borrado lógico)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="300" width="200" height="64" as="geometry"/></mxCell><mxCell id="p13c6" value="Persona" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="40" height="80" as="geometry"/></mxCell><mxCell id="p13c7" value="Rescatista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="p13c8" value="Refugio" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="40" height="80" as="geometry"/></mxCell><mxCell id="p13c9" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="290" width="40" height="80" as="geometry"/></mxCell><mxCell id="p13c10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p13c6" target="p13c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p13c6" target="p13c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p13c6" target="p13c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p13c8" target="p13c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p13c8" target="p13c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p13c8" target="p13c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p13c9" target="p13c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c17" value="" style="endArrow=block;endFill=0;html=1;rounded=0;endSize=12;" edge="1" parent="1" source="p13c7" target="p13c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p13c18" value="3.2 y 3.3: solo el publicador del perro. El administrador elimina cualquier perro (3.3), pero no publica ni edita. El refugio con verificación pendiente también publica.&lt;br&gt;Rescatista especializa a Persona y hereda todas sus asociaciones (salvo 5.3). Elipses grises con borde discontinuo: casos de uso de otra pestaña, incluidos como referencia." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="424" width="560" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="4. Adopción y favoritos"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p14t" value="Nivel 2 — 4. Adopción y favoritos" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p14s" value="ADOGTAME — 4. Adopción y favoritos" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="540" height="364" as="geometry"/></mxCell><mxCell id="p14c3" value="4.1 Agregar perro a favoritos" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="60" width="200" height="64" as="geometry"/></mxCell><mxCell id="p14c4" value="2.3 Ver información de perro" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="115" width="200" height="64" as="geometry"/></mxCell><mxCell id="p14c5" value="4.2 Solicitar adopción" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="170" width="200" height="64" as="geometry"/></mxCell><mxCell id="p14c6" value="4.3 Confirmar adopción" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="300" width="200" height="64" as="geometry"/></mxCell><mxCell id="p14c7" value="4.4 Recibir notificación de solicitud" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="200" height="64" as="geometry"/></mxCell><mxCell id="p14c8" value="Persona" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="40" height="80" as="geometry"/></mxCell><mxCell id="p14c9" value="Rescatista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="40" height="80" as="geometry"/></mxCell><mxCell id="p14c10" value="Refugio" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="p14c11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p14c8" target="p14c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p14c8" target="p14c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p14c8" target="p14c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p14c8" target="p14c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p14c10" target="p14c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p14c10" target="p14c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c17" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p14c3" target="p14c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c18" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p14c5" target="p14c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c19" value="" style="endArrow=block;endFill=0;html=1;rounded=0;endSize=12;" edge="1" parent="1" source="p14c9" target="p14c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p14c20" value="4.1 y 4.2 extienden el perfil del perro (2.3) y solo los ejecutan Persona y Rescatista. 4.3 y 4.4: solo el publicador del perro. El administrador no accede a solicitudes de adopción.&lt;br&gt;Rescatista especializa a Persona y hereda todas sus asociaciones (salvo 5.3). Elipses grises con borde discontinuo: casos de uso de otra pestaña, incluidos como referencia." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="424" width="560" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p15" name="5. Perfil y panel"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p15t" value="Nivel 2 — 5. Perfil y panel de usuario" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p15s" value="ADOGTAME — 5. Perfil y panel" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="540" height="364" as="geometry"/></mxCell><mxCell id="p15c3" value="5.1 Revisar perfil" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="180" width="200" height="64" as="geometry"/></mxCell><mxCell id="p15c4" value="5.2 Revisar notificaciones" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="200" height="64" as="geometry"/></mxCell><mxCell id="p15c5" value="5.3 Solicitar verificación como rescatista" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="200" height="64" as="geometry"/></mxCell><mxCell id="p15c6" value="5.4 Desactivar cuenta propia" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="200" height="64" as="geometry"/></mxCell><mxCell id="p15c7" value="Persona" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="40" height="80" as="geometry"/></mxCell><mxCell id="p15c8" value="Rescatista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="p15c9" value="Refugio" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="40" height="80" as="geometry"/></mxCell><mxCell id="p15c10" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="290" width="40" height="80" as="geometry"/></mxCell><mxCell id="p15c11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p15c7" target="p15c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p15c12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p15c7" target="p15c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p15c13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p15c9" target="p15c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p15c14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p15c10" target="p15c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p15c15" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p15c4" target="p15c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p15c16" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p15c5" target="p15c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p15c17" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p15c6" target="p15c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p15c18" value="" style="endArrow=block;endFill=0;html=1;rounded=0;endSize=12;" edge="1" parent="1" source="p15c8" target="p15c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p15c19" value="5.2: Persona, Rescatista y Refugio; el administrador no recibe notificaciones.&lt;br&gt;5.3: solo Persona sin solicitud pendiente ni verificación vigente (no disponible para Rescatista).&lt;br&gt;5.4: cualquier cuenta; se bloquea si es el último administrador activo.&lt;br&gt;Rescatista especializa a Persona y hereda todas sus asociaciones (salvo 5.3). Elipses grises con borde discontinuo: casos de uso de otra pestaña, incluidos como referencia." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="424" width="560" height="124" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p16" name="6. Administración"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p16t" value="Nivel 2 — 6. Administración" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p16s" value="ADOGTAME — 6. Administración" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="320" height="420" as="geometry"/></mxCell><UserObject label="6.1 Verificaciones" link="data:page/id,p161" tooltip="Abrir detalle" id="p16c3"><mxCell style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="80" width="240" height="80" as="geometry"/></mxCell></UserObject><UserObject label="6.2 Cuentas y administradores" link="data:page/id,p162" tooltip="Abrir detalle" id="p16c4"><mxCell style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="210" width="240" height="80" as="geometry"/></mxCell></UserObject><UserObject label="6.3 Contenido y catálogos" link="data:page/id,p163" tooltip="Abrir detalle" id="p16c5"><mxCell style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="340" width="240" height="80" as="geometry"/></mxCell></UserObject><mxCell id="p16c6" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="40" height="80" as="geometry"/></mxCell><mxCell id="p16c7" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p16c6" target="p16c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p16c8" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p16c6" target="p16c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p16c9" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p16c6" target="p16c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p16c10" value="Todos los casos de uso de este paquete los ejecuta solo el Administrador, desde el panel de administración. Cada subpaquete se detalla en su pestaña de nivel 3 (6.1, 6.2 y 6.3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="480" width="560" height="54" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p161" name="6.1 Verificaciones"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p161t" value="Nivel 3 — 6.1 Verificaciones" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p161s" value="ADOGTAME — 6. Administración › 6.1 Verificaciones" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="540" height="284" as="geometry"/></mxCell><mxCell id="p161c3" value="6.1.1 Revisar solicitudes de verificación" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="80" width="200" height="64" as="geometry"/></mxCell><mxCell id="p161c4" value="6.1.2 Resolver solicitud de verificación" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="200" height="64" as="geometry"/></mxCell><mxCell id="p161c5" value="6.2.1 Consultar cuentas de usuario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="220" width="200" height="64" as="geometry"/></mxCell><mxCell id="p161c6" value="6.1.3 Revocar verificación" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="220" width="200" height="64" as="geometry"/></mxCell><mxCell id="p161c7" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="40" height="80" as="geometry"/></mxCell><mxCell id="p161c8" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p161c7" target="p161c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p161c9" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p161c7" target="p161c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p161c10" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p161c4" target="p161c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p161c11" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p161c6" target="p161c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p161c12" value="6.1.2: aprobar a un rescatista lo convierte en rescatista verificado; rechazar a un refugio lo convierte en persona. El rechazo exige observación.&lt;br&gt;6.1.3: se inicia desde el detalle de una cuenta (6.2.1). Revocar a un rescatista le quita esa condición; revocar a un refugio lo convierte en persona. Exige motivo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="344" width="560" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p162" name="6.2 Cuentas y administradores"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p162t" value="Nivel 3 — 6.2 Cuentas y administradores" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p162s" value="ADOGTAME — 6. Administración › 6.2 Cuentas y administradores" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="540" height="404" as="geometry"/></mxCell><mxCell id="p162c3" value="6.2.1 Consultar cuentas de usuario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="170" width="200" height="64" as="geometry"/></mxCell><mxCell id="p162c4" value="6.2.2 Suspender cuenta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="200" height="64" as="geometry"/></mxCell><mxCell id="p162c5" value="6.2.3 Reactivar cuenta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="170" width="200" height="64" as="geometry"/></mxCell><mxCell id="p162c6" value="6.2.5 Retirar administrador" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="280" width="200" height="64" as="geometry"/></mxCell><mxCell id="p162c7" value="6.2.4 Crear administrador" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="340" width="200" height="64" as="geometry"/></mxCell><mxCell id="p162c8" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="40" height="80" as="geometry"/></mxCell><mxCell id="p162c9" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p162c8" target="p162c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p162c10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p162c8" target="p162c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p162c11" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p162c4" target="p162c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p162c12" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p162c5" target="p162c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p162c13" value="«extend»" style="endArrow=open;dashed=1;html=1;rounded=0;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="p162c6" target="p162c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p162c14" value="6.2.2 y 6.2.5: no aplican sobre la propia cuenta ni sobre el último administrador activo. 6.2.5 desactiva la cuenta del administrador retirado.&lt;br&gt;6.2.3: la cuenta conserva su perfil; una cuenta de administrador recupera el acceso administrativo. Las solicitudes de adopción canceladas no se reabren." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="464" width="560" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p163" name="6.3 Contenido y catálogos"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p163t" value="Nivel 3 — 6.3 Contenido y catálogos" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="p163s" value="ADOGTAME — 6. Administración › 6.3 Contenido y catálogos" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="40" width="540" height="284" as="geometry"/></mxCell><mxCell id="p163c3" value="6.3.1 Consultar perros eliminados" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="80" width="200" height="64" as="geometry"/></mxCell><mxCell id="p163c4" value="3.3 Eliminar perro" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="200" height="64" as="geometry"/></mxCell><mxCell id="p163c5" value="6.3.2 Gestionar catálogos&lt;br&gt;(raza y color)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="220" width="200" height="64" as="geometry"/></mxCell><mxCell id="p163c6" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="40" height="80" as="geometry"/></mxCell><mxCell id="p163c7" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p163c6" target="p163c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p163c8" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p163c6" target="p163c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p163c9" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;" edge="1" parent="1" source="p163c6" target="p163c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p163c10" value="3.3: el administrador elimina cualquier perro visible o, desde 6.3.1, los perros no eliminados de cuentas no activas. 6.3.1 es de solo lectura, sin edición ni restauración.&lt;br&gt;6.3.2: los valores en uso no se eliminan, solo se desactivan." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="344" width="560" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="peq" name="Equivalencias"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="eqt" value="Equivalencia de nomenclatura" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="600" height="30" as="geometry"/></mxCell><mxCell id="eqb" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;th&gt;Nueva&lt;/th&gt;&lt;th&gt;Revision_Final_v2&lt;/th&gt;&lt;th&gt;Caso de uso&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1.1&lt;/td&gt;&lt;td&gt;CU-01&lt;/td&gt;&lt;td&gt;Registrarse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1.2&lt;/td&gt;&lt;td&gt;CU-02&lt;/td&gt;&lt;td&gt;Iniciar sesión&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.1&lt;/td&gt;&lt;td&gt;CU-03&lt;/td&gt;&lt;td&gt;Ver perros en adopción&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;CU-04&lt;/td&gt;&lt;td&gt;Buscar y filtrar perros&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.3&lt;/td&gt;&lt;td&gt;CU-05&lt;/td&gt;&lt;td&gt;Ver información de perro&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.4&lt;/td&gt;&lt;td&gt;CU-27&lt;/td&gt;&lt;td&gt;Ver perfiles públicos y directorios&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3.1&lt;/td&gt;&lt;td&gt;CU-07&lt;/td&gt;&lt;td&gt;Poner perro en adopción&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3.2&lt;/td&gt;&lt;td&gt;CU-08&lt;/td&gt;&lt;td&gt;Editar información de perro&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3.3&lt;/td&gt;&lt;td&gt;CU-14&lt;/td&gt;&lt;td&gt;Eliminar perro&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4.1&lt;/td&gt;&lt;td&gt;CU-06&lt;/td&gt;&lt;td&gt;Agregar perro a favoritos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4.2&lt;/td&gt;&lt;td&gt;CU-09&lt;/td&gt;&lt;td&gt;Solicitar adopción&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4.3&lt;/td&gt;&lt;td&gt;CU-10&lt;/td&gt;&lt;td&gt;Confirmar adopción&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4.4&lt;/td&gt;&lt;td&gt;CU-11&lt;/td&gt;&lt;td&gt;Recibir notificación de solicitud&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.1&lt;/td&gt;&lt;td&gt;CU-12&lt;/td&gt;&lt;td&gt;Revisar perfil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.2&lt;/td&gt;&lt;td&gt;CU-13&lt;/td&gt;&lt;td&gt;Revisar notificaciones&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.3&lt;/td&gt;&lt;td&gt;CU-25&lt;/td&gt;&lt;td&gt;Solicitar verificación como rescatista&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.4&lt;/td&gt;&lt;td&gt;CU-26&lt;/td&gt;&lt;td&gt;Desactivar cuenta propia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.1.1&lt;/td&gt;&lt;td&gt;CU-15&lt;/td&gt;&lt;td&gt;Revisar solicitudes de verificación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.1.2&lt;/td&gt;&lt;td&gt;CU-16&lt;/td&gt;&lt;td&gt;Resolver solicitud de verificación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.1.3&lt;/td&gt;&lt;td&gt;CU-17&lt;/td&gt;&lt;td&gt;Revocar verificación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.2.1&lt;/td&gt;&lt;td&gt;CU-18&lt;/td&gt;&lt;td&gt;Consultar cuentas de usuario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.2.2&lt;/td&gt;&lt;td&gt;CU-19&lt;/td&gt;&lt;td&gt;Suspender cuenta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.2.3&lt;/td&gt;&lt;td&gt;CU-20&lt;/td&gt;&lt;td&gt;Reactivar cuenta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.2.4&lt;/td&gt;&lt;td&gt;CU-21&lt;/td&gt;&lt;td&gt;Crear administrador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.2.5&lt;/td&gt;&lt;td&gt;CU-22&lt;/td&gt;&lt;td&gt;Retirar administrador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.3.1&lt;/td&gt;&lt;td&gt;CU-24&lt;/td&gt;&lt;td&gt;Consultar perros eliminados&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.3.2&lt;/td&gt;&lt;td&gt;CU-23&lt;/td&gt;&lt;td&gt;Gestionar catálogos&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="560" height="820" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>