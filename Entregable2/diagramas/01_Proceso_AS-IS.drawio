eometry x="50" y="90" width="40" height="40" as="geometry"/></mxCell><mxCell id="c14" value="Buscar perros en redes sociales y ferias" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="290" y="80.0" width="130" height="60" as="geometry"/></mxCell><mxCell id="c15" value="¿Encontró un perro de interés?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=top;verticalAlign=bottom;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="460" y="85" width="50" height="50" as="geometry"/></mxCell><mxCell id="c16" value="Enviar mensaje al publicador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="550" y="80.0" width="110" height="60" as="geometry"/></mxCell><mxCell id="c17" value="Asistir a la entrevista / visita" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="1050" y="80.0" width="130" height="60" as="geometry"/></mxCell><mxCell id="c18" value="Recibir al perro en su hogar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="1310" y="80.0" width="110" height="60" as="geometry"/></mxCell><mxCell id="c19" value="Perro adoptado" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="1460" y="90" width="40" height="40" as="geometry"/></mxCell><mxCell id="c20" value="Abandona la búsqueda" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="470" y="160" width="40" height="40" as="geometry"/></mxCell><mxCell id="c21" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c17" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="espera mensajes" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="Sí" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="No" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c16" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="Sí" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="No" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="35"/><mxPoint x="725" y="35"/></Array></mxGeometry></mxCell><mxCell id="c36" value="" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="Sí" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="No" style="html=1;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="c11" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1275" y="20"/><mxPoint x="757" y="20"/></Array></mxGeometry></mxCell><mxCell id="c39" value="P1. Difusión dispersa e informal: la publicación llega a todo público, pero pocas personas son interesados reales." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="250" y="500" width="190" height="70" as="geometry"/></mxCell><mxCell id="c40" value="" style="html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c39" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="P2. Información incompleta y difícil de comparar (salud, esterilización, comportamiento)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="450" y="500" width="190" height="70" as="geometry"/></mxCell><mxCell id="c42" value="" style="html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c41" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="P3. Comunicación lenta y repartida entre varias plataformas; mensajes se pierden." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="650" y="500" width="190" height="70" as="geometry"/></mxCell><mxCell id="c44" value="" style="html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c43" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="P4. No hay forma de verificar si el publicador o el adoptante son confiables." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="850" y="500" width="190" height="70" as="geometry"/></mxCell><mxCell id="c46" value="" style="html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c45" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="P5. La elección no considera la compatibilidad perro–persona, lo que aumenta el riesgo de abandono." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="190" height="70" as="geometry"/></mxCell><mxCell id="c48" value="" style="html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c47" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>